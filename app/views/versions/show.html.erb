<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to '← 返回列表', versions_path, class: 'text-accent hover:underline' %>
  </div>

  <div class="bg-surface dark:bg-surface-dark rounded-lg shadow-sm border border-border dark:border-border-dark overflow-hidden">
    <div class="px-6 py-4 border-b border-border dark:border-border-dark flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-primary dark:text-primary-dark flex items-center gap-3">
          操作详情
          <% action_class = case @operation_log.action
             when 'create' then 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300'
             when 'update' then 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300'
             when 'destroy' then 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300'
             when 'settle' then 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300'
             when 'revert' then 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-300'
             when 'execute' then 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/50 dark:text-cyan-300'
             when 'import' then 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300'
             else 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'
             end %>
          <span class="px-2.5 py-1 text-xs font-medium rounded-full <%= action_class %>">
            <%= action_label(@operation_log.action) %>
          </span>
        </h2>
        <p class="text-sm text-secondary dark:text-secondary-dark mt-1">
          <%= @operation_log.created_at.strftime('%Y-%m-%d %H:%M:%S') %>
        </p>
      </div>
      <div class="text-right">
        <div class="text-sm text-primary dark:text-primary-dark font-medium">
          <%= item_type_label(@operation_log.item_type) %>
          <% if @operation_log.item_id && @operation_log.item_id > 0 %>
            <span class="text-secondary dark:text-secondary-dark">#<%= @operation_log.item_id %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 space-y-6">
      <!-- 描述 -->
      <div>
        <h3 class="text-sm font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider mb-2">描述</h3>
        <div class="text-primary dark:text-primary-dark bg-surface-inset dark:bg-surface-dark-inset rounded-lg p-3">
          <%= @operation_log.description %>
        </div>
      </div>

      <!-- 基本信息 -->
      <div>
        <h3 class="text-sm font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider mb-3">基本信息</h3>
        <dl class="grid grid-cols-2 gap-4 bg-surface-inset dark:bg-surface-dark-inset rounded-lg p-4">
          <div>
            <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">模型类型</dt>
            <dd class="mt-1 text-sm text-primary dark:text-primary-dark"><%= item_type_label(@operation_log.item_type) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">记录ID</dt>
            <dd class="mt-1 text-sm text-primary dark:text-primary-dark"><%= @operation_log.item_id if @operation_log.item_id > 0 %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">操作类型</dt>
            <dd class="mt-1 text-sm text-primary dark:text-primary-dark"><%= action_label(@operation_log.action) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">操作时间</dt>
            <dd class="mt-1 text-sm text-primary dark:text-primary-dark"><%= @operation_log.created_at.strftime('%Y-%m-%d %H:%M:%S') %></dd>
          </div>
        </dl>
      </div>

      <!-- 请求信息 -->
      <% if @operation_log.request_path || @operation_log.ip_address %>
        <div>
          <h3 class="text-sm font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider mb-3">请求信息</h3>
          <dl class="grid grid-cols-2 gap-4 bg-surface-inset dark:bg-surface-dark-inset rounded-lg p-4">
            <div>
              <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">请求路径</dt>
              <dd class="mt-1 text-sm font-mono text-primary dark:text-primary-dark break-all">
                <%= @operation_log.request_method %> <%= @operation_log.request_path %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">IP 地址</dt>
              <dd class="mt-1 text-sm text-primary dark:text-primary-dark">
                <% if @operation_log.ip_address.present? %>
                  <%= link_to @operation_log.ip_address, versions_path(ip_address: @operation_log.ip_address), class: 'text-accent hover:underline' %>
                <% else %>
                  <span class="text-tertiary dark:text-tertiary-dark">-</span>
                <% end %>
              </dd>
            </div>
            <% if @operation_log.user_agent %>
              <div class="col-span-2">
                <dt class="text-sm font-medium text-secondary dark:text-secondary-dark">User Agent</dt>
                <dd class="mt-1 text-sm text-tertiary dark:text-tertiary-dark truncate" title="<%= @operation_log.user_agent %>"><%= @operation_log.user_agent %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>

      <!-- 变更内容 -->
      <% if @operation_log.changeset.present? %>
        <%
          parsed = @operation_log.changeset.is_a?(String) ? (JSON.parse(@operation_log.changeset) rescue {}) : @operation_log.changeset
          is_update_diff = @operation_log.action == 'update' && parsed.is_a?(Hash) && parsed.values.any? { |v| v.is_a?(Array) && v.length == 2 }
        %>
        <div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">
              变更内容
              <% if is_update_diff %>
                <span class="ml-2 text-xs text-tertiary dark:text-tertiary-dark font-normal">(Diff 视图)</span>
              <% end %>
            </h3>
            <% if is_update_diff %>
              <button onclick="toggleDiffView()" class="text-xs text-accent hover:underline">
                <span id="diffToggleLabel">查看原始 JSON</span>
              </button>
            <% end %>
          </div>

          <!-- Diff 视图 (仅 update 操作展示) -->
          <% if is_update_diff %>
            <div id="diffView" class="bg-surface-inset dark:bg-surface-dark-inset rounded-lg overflow-hidden">
              <div class="flex text-xs font-medium text-secondary dark:text-secondary-dark border-b border-border dark:border-border-dark">
                <div class="w-1/3 px-4 py-2 border-r border-border dark:border-border-dark">字段</div>
                <div class="w-1/3 px-4 py-2 border-r border-border dark:border-border-dark bg-red-50/50 dark:bg-red-950/20">旧值</div>
                <div class="w-1/3 px-4 py-2 bg-green-50/50 dark:bg-green-950/20">新值</div>
              </div>
              <% parsed.each do |field, values| %>
                <% next if field.in?(%w[updated_at created_at id]) %>
                <div class="flex border-b border-border dark:border-border-dark last:border-b-0">
                  <div class="w-1/3 px-4 py-2.5 border-r border-border dark:border-border-dark font-mono text-sm text-secondary dark:text-secondary-dark">
                    <%= field %>
                  </div>
                  <div class="w-1/3 px-4 py-2.5 border-r border-border dark:border-border-dark bg-red-50/50 dark:bg-red-950/20">
                    <% if values.is_a?(Array) && values.length == 2 %>
                      <span class="text-sm text-red-600 dark:text-red-400 line-through"><%= values[0].nil? ? '(空)' : values[0] %></span>
                    <% end %>
                  </div>
                  <div class="w-1/3 px-4 py-2.5 bg-green-50/50 dark:bg-green-950/20">
                    <% if values.is_a?(Array) && values.length == 2 %>
                      <span class="text-sm text-green-600 dark:text-green-400"><%= values[1].nil? ? '(空)' : values[1] %></span>
                    <% else %>
                      <span class="text-sm text-primary dark:text-primary-dark"><%= values.nil? ? '(空)' : values %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- JSON 视图 (默认隐藏，仅 update 有 diff 时才切换) -->
            <div id="jsonView" class="hidden bg-surface-inset dark:bg-surface-dark-inset rounded-lg p-4">
              <pre class="text-xs overflow-x-auto text-primary dark:text-primary-dark"><%= JSON.pretty_generate(parsed) rescue @operation_log.changeset %></pre>
            </div>
          <% else %>
            <!-- 非 update 操作：直接展示 JSON -->
            <div class="bg-surface-inset dark:bg-surface-dark-inset rounded-lg p-4">
              <pre class="text-xs overflow-x-auto text-primary dark:text-primary-dark"><%= JSON.pretty_generate(parsed) rescue @operation_log.changeset %></pre>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- 请求参数 -->
      <% if @operation_log.request_params.present? %>
        <div>
          <h3 class="text-sm font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider mb-3">请求参数</h3>
          <div class="bg-surface-inset dark:bg-surface-dark-inset rounded-lg p-4">
            <pre class="text-xs overflow-x-auto text-primary dark:text-primary-dark"><%= JSON.pretty_generate(@operation_log.request_params) rescue '无法解析' %></pre>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @operation_log.action == 'update' %>
  <script>
  (function() {
    let showingJson = false;
    window.toggleDiffView = function() {
      const diffView = document.getElementById('diffView');
      const jsonView = document.getElementById('jsonView');
      const label = document.getElementById('diffToggleLabel');
      if (!diffView || !jsonView) return;
      if (showingJson) {
        diffView.classList.remove('hidden');
        jsonView.classList.add('hidden');
        label.textContent = '查看原始 JSON';
      } else {
        diffView.classList.add('hidden');
        jsonView.classList.remove('hidden');
        label.textContent = '查看 Diff 视图';
      }
      showingJson = !showingJson;
    };
  })();
  </script>
<% end %>
