<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-primary dark:text-primary-dark">操作日志</h1>
      <p class="mt-1 text-sm text-secondary dark:text-secondary-dark">查看所有用户操作历史</p>
    </div>
    <div class="flex gap-2">
      <button onclick="exportData('csv')" class="px-3 py-2 border border-border dark:border-border-dark rounded-lg text-sm font-medium hover:bg-surface-hover dark:hover:bg-surface-dark-hover text-primary dark:text-primary-dark flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        导出 CSV
      </button>
      <button onclick="exportData('json')" class="px-3 py-2 border border-border dark:border-border-dark rounded-lg text-sm font-medium hover:bg-surface-hover dark:hover:bg-surface-dark-hover text-primary dark:text-primary-dark flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        JSON
      </button>
    </div>
  </div>

  <!-- 统计卡片 -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-surface dark:bg-surface-dark rounded-lg p-4 border border-border dark:border-border-dark">
      <div class="text-2xl font-bold text-primary dark:text-primary-dark"><%= @stats[:today] %></div>
      <div class="text-sm text-secondary dark:text-secondary-dark mt-1">今日操作</div>
    </div>
    <div class="bg-surface dark:bg-surface-dark rounded-lg p-4 border border-border dark:border-border-dark">
      <div class="text-2xl font-bold text-green-600 dark:text-green-400"><%= @stats[:create] %></div>
      <div class="text-sm text-secondary dark:text-secondary-dark mt-1">今日创建</div>
    </div>
    <div class="bg-surface dark:bg-surface-dark rounded-lg p-4 border border-border dark:border-border-dark">
      <div class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= @stats[:update] %></div>
      <div class="text-sm text-secondary dark:text-secondary-dark mt-1">今日更新</div>
    </div>
    <div class="bg-surface dark:bg-surface-dark rounded-lg p-4 border border-border dark:border-border-dark">
      <div class="text-2xl font-bold text-red-600 dark:text-red-400"><%= @stats[:destroy] %></div>
      <div class="text-sm text-secondary dark:text-secondary-dark mt-1">今日删除</div>
    </div>
  </div>

  <!-- 快捷筛选 Chips -->
  <div class="mb-4 flex flex-wrap gap-2">
    <span class="text-sm text-secondary dark:text-secondary-dark self-center mr-1">快捷筛选:</span>
    <% @quick_presets.each do |preset| %>
      <%
        is_active = preset[:params].all? do |k, v|
          params[k].present? && params[k].to_s == v.to_s
        end
      %>
      <a href="<%= versions_path(preset[:params].merge(params.permit(:item_type, :action_type, :search, :ip_address, :date_from, :date_to).to_h)) %>"
         class="px-3 py-1.5 text-sm rounded-full border transition-colors <%= is_active ? 'bg-accent text-white border-accent' : 'border-border dark:border-border-dark text-primary dark:text-primary-dark hover:bg-surface-hover dark:hover:bg-surface-dark-hover' %>">
        <%= preset[:label] %>
      </a>
    <% end %>
  </div>

  <!-- 活动筛选标签 -->
  <% if @active_filters.any? %>
    <div class="mb-4 flex flex-wrap gap-2 items-center">
      <span class="text-sm text-secondary dark:text-secondary-dark">当前筛选:</span>
      <% @active_filters.each do |filter| %>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-accent/10 text-accent dark:bg-accent/20 rounded-full text-sm">
          <%= filter[:label] %>
          <button onclick="removeFilter('<%= filter[:key] %>')" class="ml-1 hover:text-accent-hover">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </span>
      <% end %>
      <a href="<%= versions_path %>" class="text-sm text-accent hover:underline ml-2">清除全部</a>
    </div>
  <% end %>

  <!-- 筛选器 -->
  <div class="mb-6 bg-surface dark:bg-surface-dark rounded-lg p-4 border border-border dark:border-border-dark">
    <form method="get" id="filterForm" class="flex flex-wrap gap-4 items-end">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-sm font-medium text-primary dark:text-primary-dark mb-1">搜索</label>
        <input type="text" name="search" value="<%= params[:search] %>" placeholder="搜索描述内容..."
          class="w-full rounded-lg border border-border dark:border-border-dark bg-white dark:bg-container-dark px-3 py-2 text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none">
      </div>

      <div>
        <label class="block text-sm font-medium text-primary dark:text-primary-dark mb-1">模型类型</label>
        <select name="item_type" class="rounded-lg border border-border dark:border-border-dark bg-white dark:bg-container-dark px-3 py-2 text-sm">
          <option value="">全部</option>
          <% VersionsController::ITEM_TYPE_LABELS.each do |key, label| %>
            <option value="<%= key %>" <%= 'selected' if params[:item_type] == key %>><%= label %></option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-primary dark:text-primary-dark mb-1">操作类型</label>
        <select name="action_type" class="rounded-lg border border-border dark:border-border-dark bg-white dark:bg-container-dark px-3 py-2 text-sm">
          <option value="">全部</option>
          <% VersionsController::ACTION_LABELS.each do |key, label| %>
            <option value="<%= key %>" <%= 'selected' if params[:action_type] == key %>><%= label %></option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-primary dark:text-primary-dark mb-1">开始日期</label>
        <input type="date" name="date_from" value="<%= params[:date_from] %>"
          class="rounded-lg border border-border dark:border-border-dark bg-white dark:bg-container-dark px-3 py-2 text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-primary dark:text-primary-dark mb-1">结束日期</label>
        <input type="date" name="date_to" value="<%= params[:date_to] %>"
          class="rounded-lg border border-border dark:border-border-dark bg-white dark:bg-container-dark px-3 py-2 text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-primary dark:text-primary-dark mb-1">IP 地址</label>
        <input type="text" name="ip_address" value="<%= params[:ip_address] %>" placeholder="筛选 IP"
          class="rounded-lg border border-border dark:border-border-dark bg-white dark:bg-container-dark px-3 py-2 text-sm w-36">
      </div>

      <div class="flex gap-2">
        <button type="submit" class="px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium hover:bg-accent-hover transition-colors">
          筛选
        </button>
        <a href="<%= versions_path %>" class="px-4 py-2 border border-border dark:border-border-dark rounded-lg text-sm font-medium hover:bg-surface-hover dark:hover:bg-surface-dark-hover text-primary dark:text-primary-dark transition-colors">
          清除
        </a>
      </div>
    </form>
  </div>

  <!-- 操作日志列表 -->
  <div class="bg-surface dark:bg-surface-dark rounded-lg shadow-sm border border-border dark:border-border-dark overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-border dark:divide-border-dark">
        <thead class="bg-surface-inset dark:bg-surface-dark-inset">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider w-8"></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">时间</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">操作</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">模型</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">详情</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">IP</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-secondary dark:text-secondary-dark uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody id="logsTableBody" class="divide-y divide-border dark:divide-border-dark">
          <% @operation_logs.each do |log| %>
            <tr class="hover:bg-surface-hover dark:hover:bg-surface-dark-hover cursor-pointer" onclick="toggleRow(<%= log.id %>)">
              <td class="px-4 py-3">
                <svg id="chevron-<%= log.id %>" class="w-4 h-4 text-secondary dark:text-secondary-dark transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-primary dark:text-primary-dark">
                <%= log.created_at.strftime('%Y-%m-%d %H:%M:%S') %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% action_class = case log.action
                   when 'create' then 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300'
                   when 'update' then 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300'
                   when 'destroy' then 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300'
                   when 'settle' then 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300'
                   when 'revert' then 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-300'
                   when 'execute' then 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/50 dark:text-cyan-300'
                   when 'import' then 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300'
                   when 'export' then 'bg-teal-100 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300'
                   when 'backup' then 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300'
                   when 'restore' then 'bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300'
                   else 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'
                   end %>
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= action_class %>">
                  <%= action_label(log.action) %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-primary dark:text-primary-dark">
                <%= item_type_label(log.item_type) %>
                <% if log.item_id && log.item_id > 0 %>
                  <span class="text-secondary dark:text-secondary-dark">#<%= log.item_id %></span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-secondary dark:text-secondary-dark max-w-md">
                <div class="truncate"><%= log.description %></div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-xs text-secondary dark:text-secondary-dark">
                <% if log.ip_address %>
                  <%= log.ip_address %>
                <% else %>
                  <span class="text-tertiary dark:text-tertiary-dark">-</span>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
                <a href="<%= version_path(log) %>" class="text-accent hover:underline" onclick="event.stopPropagation()">详情</a>
              </td>
            </tr>
            <tr id="expand-<%= log.id %>" class="hidden bg-surface-inset/50 dark:bg-surface-dark-inset/50">
              <td colspan="7" class="px-6 py-4">
                <% if log.action.in?(['update', 'settle', 'execute']) && log.changeset.present? %>
                  <div class="mb-2">
                    <span class="text-xs font-medium text-secondary dark:text-secondary-dark uppercase">变更摘要:</span>
                  </div>
                  <div class="text-sm text-primary dark:text-primary-dark space-y-1">
                    <% parsed = log.changeset.is_a?(String) ? (JSON.parse(log.changeset) rescue {}) : log.changeset %>
                    <% if parsed.is_a?(Hash) %>
                      <% parsed.each do |field, values| %>
                        <% next if field.in?(%w[updated_at created_at id]) %>
                        <div class="flex gap-3">
                          <span class="font-mono text-secondary dark:text-secondary-dark min-w-[120px]"><%= field %>:</span>
                          <% if values.is_a?(Array) && values.length == 2 %>
                            <span class="line-through text-red-500 dark:text-red-400"><%= values[0].presence || '(空)' %></span>
                            <span class="text-secondary dark:text-secondary-dark">→</span>
                            <span class="text-green-600 dark:text-green-400"><%= values[1].presence || '(空)' %></span>
                          <% else %>
                            <span class="text-primary dark:text-primary-dark"><%= values %></span>
                          <% end %>
                        </div>
                      <% end %>
                    <% else %>
                      <%= log.changes_summary %>
                    <% end %>
                  </div>
                <% elsif log.action == 'create' && log.changeset.present? %>
                  <div class="mb-2">
                    <span class="text-xs font-medium text-secondary dark:text-secondary-dark uppercase">创建数据:</span>
                  </div>
                  <div class="text-xs font-mono text-primary dark:text-primary-dark bg-surface-inset dark:bg-surface-dark-inset rounded p-2 max-h-40 overflow-y-auto">
                    <%= log.changes_summary %>
                  </div>
                <% else %>
                  <div class="text-sm text-secondary dark:text-secondary-dark">
                    点击 <a href="<%= version_path(log) %>" class="text-accent hover:underline">详情</a> 查看完整数据
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- 加载更多 (无限滚动) -->
    <div id="loadMoreContainer" class="py-4 text-center border-t border-border dark:border-border-dark">
      <% if @operation_logs.next_page %>
        <button onclick="loadMore()" id="loadMoreBtn" class="px-4 py-2 border border-border dark:border-border-dark rounded-lg text-sm font-medium hover:bg-surface-hover dark:hover:bg-surface-dark-hover text-primary dark:text-primary-dark">
          加载更多
        </button>
      <% else %>
        <div class="text-sm text-secondary dark:text-secondary-dark">
          没有更多了 ~
        </div>
      <% end %>
    </div>
  </div>

  <!-- 当前页码 (用于无限滚动) -->
  <div id="currentPage" data-page="<%= @operation_logs.current_page %>" data-total-pages="<%= @operation_logs.total_pages %>"></div>
</div>

<script>
(function() {
  // 行展开/收起
  window.toggleRow = function(id) {
    const row = document.getElementById('expand-' + id);
    const chevron = document.getElementById('chevron-' + id);
    if (row.classList.contains('hidden')) {
      row.classList.remove('hidden');
      chevron.style.transform = 'rotate(90deg)';
    } else {
      row.classList.add('hidden');
      chevron.style.transform = 'rotate(0deg)';
    }
  };

  // 移除单个筛选条件
  window.removeFilter = function(key) {
    const params = new URLSearchParams(window.location.search);
    if (key === 'date_range') {
      params.delete('date_from');
      params.delete('date_to');
    } else {
      params.delete(key);
    }
    window.location.href = '<%= versions_path %>' + (params.toString() ? '?' + params.toString() : '');
  };

  // 导出
  window.exportData = function(format) {
    const params = new URLSearchParams(window.location.search);
    params.set('format', format);
    window.location.href = '<%= versions_path %>' + '?' + params.toString();
  };

  // 无限滚动
  let currentPage = parseInt(document.getElementById('currentPage').dataset.page);
  const totalPages = parseInt(document.getElementById('currentPage').dataset.totalPages);
  let loading = false;

  window.loadMore = function() {
    if (loading || currentPage >= totalPages) return;
    loading = true;
    const btn = document.getElementById('loadMoreBtn');
    if (btn) btn.textContent = '加载中...';

    currentPage++;
    const params = new URLSearchParams(window.location.search);
    params.set('page', currentPage);

    fetch('<%= versions_path %>?' + params.toString(), {
      headers: { 'Accept': 'text/html' }
    })
    .then(res => res.text())
    .then(html => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newRows = doc.querySelectorAll('#logsTableBody tr');
      const tbody = document.getElementById('logsTableBody');
      newRows.forEach(row => tbody.appendChild(row.cloneNode(true)));

      const newLoadMore = doc.querySelector('#loadMoreContainer');
      const container = document.getElementById('loadMoreContainer');
      if (newLoadMore) {
        container.innerHTML = newLoadMore.innerHTML;
      }

      document.getElementById('currentPage').dataset.page = currentPage;
      loading = false;
    })
    .catch(() => {
      loading = false;
      if (btn) btn.textContent = '加载更多';
    });
  };

  // 滚动到底部自动加载
  window.addEventListener('scroll', function() {
    const container = document.getElementById('loadMoreContainer');
    if (!container || loading || currentPage >= totalPages) return;
    const rect = container.getBoundingClientRect();
    if (rect.top < window.innerHeight + 200) {
      loadMore();
    }
  });
})();
</script>
